{
  "name": "@dshapp/dsh-claude-subscription",
  "version": "0.1.2",
  "description": "DeepSeek Harness (DSH) bundle: shares a Claude Code (Pro/Max/Team) subscription credential with the harness, so the built-in Anthropic provider runs on the subscription instead of a separate API key.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "claude",
    "claude-code",
    "anthropic",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dshapp/dsh-claude-subscription.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
